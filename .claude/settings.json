{
  "permissions": {
    "allow": [
      "Bash(bunx tsc --noEmit*)",
      "Bash(bun run lint*)",
      "Bash(bun run format*)",
      "Bash(bun test*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(axe *)",
      "Bash(xcrun simctl *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/*.p8)",
      "Read(**/*.p12)",
      "Bash(supabase db reset*)",
      "Bash(git push --force*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-secrets.sh\""
          }
        ]
      }
    ]
  }
}
