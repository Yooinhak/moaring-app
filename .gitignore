# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# 로컬 Expo 모듈(modules/*)의 Gradle 빌드 산출물 — 소스는 커밋, 빌드 결과는 제외
modules/*/android/build/
modules/*/android/.cxx/
modules/*/android/.gradle/

# Claude Code — 공유 하네스만 추적, 개인 설정(settings.local.json 등)은 무시
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/hooks/

# 마크다운 — 기본 무시, 문서·하네스는 추적
*.md
!README.md
!CLAUDE.md
!.claude/**/*.md
!docs/**/*.md
!.github/**/*.md

# bkit
.bkit/
.bkit-memory.json
docs/package-lock.json
package-lock.json
